{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-lens.dev/schemas/canonical-device.json",
  "title": "Network Lens Canonical Device",
  "description": "Vendor-neutral device intent aligned with iosxe.devices[].configuration.* (netascode/nac-iosxe/iosxe)",
  "type": "object",
  "required": ["name", "configuration"],
  "properties": {
    "name": { "type": "string" },
    "host": { "type": ["string", "null"] },
    "secrets_redacted": { "type": "boolean" },
    "configuration": { "$ref": "#/$defs/deviceConfiguration" },
    "system": { "$ref": "#/$defs/deviceSystem", "description": "Legacy flat mirror of configuration.system" },
    "interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" },
      "description": "Legacy flat list of all interface kinds"
    },
    "static_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/staticRoute" },
      "description": "Legacy flat mirror of configuration.routing.static_routes"
    }
  },
  "$defs": {
    "deviceConfiguration": {
      "type": "object",
      "properties": {
        "system": { "$ref": "#/$defs/deviceSystem" },
        "users": { "type": "array", "items": { "$ref": "#/$defs/userAccount" } },
        "banner": { "$ref": "#/$defs/bannerConfig" },
        "clock": { "$ref": "#/$defs/clockConfig" },
        "line": { "type": "object" },
        "aaa": { "type": "object" },
        "access_lists": { "$ref": "#/$defs/accessListsConfig" },
        "as_path_access_lists": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "community_lists": { "$ref": "#/$defs/communityListsConfig" },
        "prefix_lists": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "route_maps": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "policy": { "type": "object" },
        "class_maps": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "policy_maps": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "parameter_maps": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "key_chains": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "routing": { "$ref": "#/$defs/routingConfig" },
        "vrfs": { "type": "array", "items": { "$ref": "#/$defs/vrf" } },
        "interfaces": { "$ref": "#/$defs/deviceInterfaces" },
        "vlan": { "type": "object" },
        "templates": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "snmp_server": { "type": "object" },
        "ntp": { "type": "object" },
        "logging": { "type": "object" },
        "dhcp": { "type": "object" },
        "dhcp_pools": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "ipv6_dhcp_pools": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "nat": { "type": "object" },
        "bfd": { "type": "object" },
        "cdp": { "type": "object" },
        "lldp": { "type": "object" },
        "spanning_tree": { "type": "object" },
        "udld": { "type": "object" },
        "vtp": { "type": "object" },
        "license": { "type": "object" },
        "crypto": { "type": "object" },
        "flow": { "type": "object" },
        "evpn": { "type": "object" },
        "evpn_profile": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "mpls": { "type": "object" },
        "pim": { "type": "object" },
        "msdp": { "type": "object" },
        "multicast": { "type": "object" },
        "errdisable": { "type": "object" },
        "dot1x": { "type": "object" },
        "eem": { "type": "object" },
        "cts": { "type": "object" },
        "device_sensor": { "type": "object" },
        "device_tracking": { "type": "object" },
        "bridge_domain": { "type": "array" },
        "l2_vfi": { "type": "array" },
        "sla": { "type": "array" },
        "mdt_subscription": { "type": "array" },
        "zone_security": { "type": "array" },
        "zone_pair_security": { "type": "array" },
        "service": { "type": "object" },
        "service_templates": { "type": "array", "items": { "$ref": "#/$defs/namedListEntry" } },
        "arp": { "type": "object" },
        "radius": { "type": "object" },
        "tacacs_server": { "type": "object" }
      }
    },
    "deviceSystem": {
      "type": "object",
      "properties": {
        "hostname": { "type": ["string", "null"] },
        "ipv6_unicast_routing": { "type": "boolean" },
        "mtu": { "type": ["integer", "null"] },
        "ip_routing": { "type": ["boolean", "null"] },
        "ip_domain_name": { "type": ["string", "null"] },
        "enable_secret": { "type": ["string", "null"] }
      }
    },
    "userAccount": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "privilege": { "type": ["integer", "null"] },
        "password": { "type": ["string", "null"] },
        "password_type": { "type": ["string", "null"] },
        "secret": { "type": ["string", "null"] },
        "secret_type": { "type": ["string", "null"] }
      }
    },
    "bannerConfig": {
      "type": "object",
      "properties": {
        "exec": { "type": ["string", "null"] },
        "login": { "type": ["string", "null"] },
        "motd": { "type": ["string", "null"] },
        "prompt_timeout": { "type": ["string", "null"] }
      }
    },
    "clockConfig": {
      "type": "object",
      "properties": {
        "timezone": { "type": ["string", "null"] },
        "timezone_offset_hours": { "type": ["integer", "null"] },
        "summer_time_zone": { "type": ["string", "null"] }
      }
    },
    "accessListsConfig": {
      "type": "object",
      "properties": {
        "standard": { "type": "array" },
        "extended": { "type": "array" },
        "role_based": { "type": "array" }
      }
    },
    "communityListsConfig": {
      "type": "object",
      "properties": {
        "standard": { "type": "array" },
        "expanded": { "type": "array" }
      }
    },
    "namedListEntry": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" }
      }
    },
    "routingConfig": {
      "type": "object",
      "properties": {
        "static_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/staticRoute" }
        },
        "ospf_processes": { "type": "array" },
        "bgp": { "type": "object" },
        "isis": { "type": "object" }
      }
    },
    "vrf": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "route_distinguisher": { "type": ["string", "null"] },
        "rd_auto": { "type": ["boolean", "null"] }
      }
    },
    "deviceInterfaces": {
      "type": "object",
      "properties": {
        "loopbacks": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "ethernets": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "vlans": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "tunnels": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "port_channels": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "port_channel_subinterfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "ethernet_subinterfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "bdis": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "nves": { "type": "array", "items": { "$ref": "#/$defs/interface" } }
      }
    },
    "interface": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string" },
        "kind": {
          "enum": [
            "loopback",
            "ethernet",
            "tunnel",
            "vlan",
            "port_channel",
            "port_channel_subinterface",
            "ethernet_subinterface",
            "bdi",
            "nve"
          ]
        },
        "shutdown": { "type": "boolean" },
        "description": { "type": ["string", "null"] },
        "ipv4_address": { "type": ["string", "null"] },
        "ipv4_address_mask": { "type": ["string", "null"] },
        "ipv4_dhcp": { "type": "boolean" }
      }
    },
    "staticRoute": {
      "type": "object",
      "required": ["prefix"],
      "properties": {
        "prefix": { "type": "string" },
        "prefix_length": { "type": ["integer", "null"] },
        "mask": { "type": ["string", "null"] },
        "vrf": { "type": ["string", "null"] },
        "next_hop": { "type": ["string", "null"] },
        "interface": { "type": ["string", "null"] },
        "next_hops": { "type": "array" }
      }
    }
  }
}
